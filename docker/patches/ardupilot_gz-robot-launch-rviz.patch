+    # chokes on ArduPilot sensor types. Sensors aren't needed for the kinematic
+    # tree. They live in nested <include> models, so flatten the model with
+    # `gz sdf -p` and strip every <sensor> block. Gazebo still spawns the full
+    # model (with sensors) via `create -file`, so flight is unaffected.
+    try:
+        flat = subprocess.run(
