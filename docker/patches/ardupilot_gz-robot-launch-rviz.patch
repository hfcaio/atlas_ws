+            capture_output=True,
+            text=True,
+            timeout=30,
+        ).stdout
+    except Exception:
+        flat = ""
+    rsp_desc = re.sub(r"<sensor[\s\S]*?</sensor>", "", flat if flat.strip() else robot_desc)
