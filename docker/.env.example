# copia para .env
# printf "UID=%s\nGID=%s\n" "$(id -u)" "$(id -g)" >> .env

UID=1000
GID=100

# workspace ROS 2 no host (a pasta que tem src/, nao o src/)
ATLAS_WS_HOST=/home/caio/git_projects/atlas_ws

# copter | plane | vtol
VEHICLE=copter

# build da imagem
ARDUPILOT_REF=master
BUILD_ARDUPILOT=0     # 0 = imagem leve; o ArduPilot vem do src/ (atlas-ws-init + atlas-build)
                     #     1 = compila copter+plane no /opt/ardupilot (imagem self-contained, +20min)
WAF_JOBS=4

# runtime
ROS_DOMAIN_ID=0
HEADLESS=0
SPEEDUP=1
WAIT_GAZEBO=8
MAVROS_DELAY=15
FCU_URL=udp://:14550@
# GCS_URL=udp://@192.168.1.50:14550
# LIBGL_ALWAYS_SOFTWARE=1
