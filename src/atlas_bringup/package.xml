<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>atlas_bringup</name>
  <version>0.1.0</version>
  <description>Launch files de simulacao do ATLAS: sobe Gazebo + ArduPilot SITL + MAVROS
    para copter/plane/vtol. Wrapper ROS 2 em torno dos scripts ap-gazebo/ap-sitl/ap-mavros.</description>
  <maintainer email="caio.freitas@hprobotics.pro">caio</maintainer>
  <license>GPL-3.0-or-later</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>mavros</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
